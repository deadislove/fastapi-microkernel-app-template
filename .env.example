# Application
APP_NAME=fastapi-microkernel-app-template
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Plugin loading
# PLUGIN_LOAD_MODE: fail_fast (default) aborts startup if any plugin's
# register()/boot() raises; best_effort isolates the failing plugin and
# still starts up the rest of the kernel.
PLUGIN_LOAD_MODE=fail_fast
# ENABLED_PLUGINS: JSON array of plugin directory names to load. Omit (or
# leave unset) to load every plugin under app/plugins/.
# ENABLED_PLUGINS=["user_plugin","product_plugin"]

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
